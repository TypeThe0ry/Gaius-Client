# Both names must resolve to this host before Caddy can obtain certificates.
GAIUS_RELAY_DOMAIN=relay.example.com
GAIUS_REGISTRY_DOMAIN=registry.example.com

# This public node intentionally accepts every browser origin.
GAIUS_ALLOWED_ORIGINS=*

# Generate with: openssl rand -hex 32
GAIUS_REGISTRY_TOKEN=replace-with-at-least-16-random-characters

GAIUS_RELAY_NODE_ID=example-public-1
GAIUS_RELAY_NODE_NAME=Example Public RelayNode
GAIUS_RELAY_PRIORITY=0

# Published in the node manifest at abuseContact. mailto: or https: only.
GAIUS_ABUSE_CONTACT=mailto:abuse@example.com
GAIUS_MAXIMUM_CONNECTIONS=256

# Tunnel traffic limits (bytes; 0 disables each limit). Rate limits pause the
# tunnel source instead of dropping bytes; the transfer cap closes the tunnel
# with 1009 once a single connection exceeds it.
GAIUS_MAXIMUM_BANDWIDTH_PER_CONNECTION=0
GAIUS_MAXIMUM_BANDWIDTH_TOTAL=0
GAIUS_MAXIMUM_TRANSFER_PER_CONNECTION=0
GAIUS_TRAFFIC_STATS=1

# Private OpenTelemetry metrics. The pull listener binds loopback by default
# and must stay behind a private interface or VPN; it is never exposed through
# the public reverse-proxy config. The push exporter targets an OTLP/HTTP
# collector instead of opening a port.
# GAIUS_OTEL_PORT=18821
# GAIUS_OTEL_HOST=127.0.0.1
# GAIUS_OTEL_EXPORTER_URL=http://collector.example:4318/v1/metrics
# GAIUS_OTEL_EXPORT_INTERVAL_MS=60000
