{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gaius-pages-relay-origin-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "pages-relay.ellan.site/*",
      "zone_name": "ellan.site"
    }
  ]
}
