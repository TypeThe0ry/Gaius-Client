# Copy this file to /etc/gaius/relaynode.env and replace the public origin.
# This example contains no credential, registry token, or private endpoint.

# Bind locally; Nginx is the only public entry point.
GAIUS_BRIDGE_HOST=127.0.0.1
GAIUS_BRIDGE_PORT=8080

# The wildcard allows any public Java server. The explicit 0 keeps private,
# loopback, link-local, CGNAT, multicast, and reserved targets blocked.
GAIUS_ALLOWED_HOSTS=*
GAIUS_ALLOW_PRIVATE_TARGETS=0

# Keep the real hosted client origin and the downloaded file:// origin (null).
# Replace the example origin with the actual Gaius web origin.
GAIUS_ALLOWED_ORIGINS=*

# Public server packs may be hosted separately from the Java server.
# Restrict this to known CDN hosts when operating a limited-purpose node.
GAIUS_ALLOWED_RESOURCE_PACK_HOSTS=*

# Connection, traffic, frame, and timeout bounds.
GAIUS_MAXIMUM_CONNECTIONS=256
GAIUS_MAXIMUM_FRAME_BYTES=16777216
GAIUS_CONNECT_TIMEOUT_MS=10000
GAIUS_DNS_RETRY_ATTEMPTS=2
GAIUS_DNS_RETRY_DELAY_MS=75
GAIUS_IDLE_TIMEOUT_MS=600000
GAIUS_TARGET_AFFINITY_MS=300000
GAIUS_MAXIMUM_TARGET_ROUTES=4096
GAIUS_RESOURCE_PACK_CACHE_MS=300000
GAIUS_RESOURCE_PACK_CACHE_BYTES=536870912
GAIUS_RESOURCE_PACK_CACHE_ENTRIES=64
GAIUS_PROXY_KEEPALIVES=1

# Public identity, used in the manifest and logs. Do not put secrets here.
GAIUS_RELAY_NODE_NAME=Example Public Gaius RelayNode

# Optional registry registration is intentionally omitted from this template.
# If a private registry is used, provide its URL and a real token only in the
# root-owned /etc/gaius/relaynode.env on the server, never in Git.
# GAIUS_RELAY_REGISTRY_URL=https://registry.example.com/relay-registry/v1/nodes/
# GAIUS_RELAY_REGISTRY_TOKEN=replace-with-a-random-token-of-at-least-16-characters
# GAIUS_RELAY_NODE_ID=example-public-1
# GAIUS_RELAY_PUBLIC_URL=wss://relay.example.com/tunnel
# GAIUS_RELAY_PRIORITY=0
