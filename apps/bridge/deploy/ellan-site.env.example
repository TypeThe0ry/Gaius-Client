# Canonical deployment values for the live Gaius Pages + RelayNode pair.
# Copy the values (without this comment block) into the root-owned
# /etc/gaius/relaynode.env on the ellan.site host.
GAIUS_ALLOWED_ORIGINS=*
GAIUS_ALLOWED_HOSTS=*
GAIUS_ALLOW_PRIVATE_TARGETS=0
GAIUS_ALLOWED_RESOURCE_PACK_HOSTS=*
GAIUS_RESOURCE_PACK_BODY_IDLE_TIMEOUT_MS=30000
GAIUS_RESOURCE_PACK_STREAM_OVERALL_TIMEOUT_MS=600000
GAIUS_RESOURCE_PACK_CACHE_MS=900000
GAIUS_RESOURCE_PACK_CACHE_BYTES=536870912
GAIUS_RESOURCE_PACK_CACHE_ENTRIES=64
GAIUS_RELAY_NODE_NAME=Gaius HK Relay

# The browser endpoint must use the DNS name below. Do not substitute the
# origin IP: its certificate is not valid for an IP literal.
GAIUS_RELAY_PUBLIC_URL=wss://ellan.site/tunnel
