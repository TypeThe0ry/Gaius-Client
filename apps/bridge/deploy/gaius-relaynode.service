[Unit]
Description=Gaius public RelayNode
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=gaius
Group=gaius
WorkingDirectory=/opt/gaius/apps/bridge
EnvironmentFile=/etc/gaius/relaynode.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/gaius/apps/bridge/dist/main.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gaius-relaynode
StateDirectory=gaius-relaynode
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
