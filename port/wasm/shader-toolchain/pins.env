# Pinned inputs of the browser shader toolchain (PLAN D5, backend T1).
#
# shaderc and SPIRV-Cross are the exact revisions the LWJGL 3.4.3 natives of
# Minecraft 26.3 were built from (the *.dll.git files in the lwjgl-shaderc and
# lwjgl-spvc natives jars); glslang, SPIRV-Tools and SPIRV-Headers are the
# revisions pinned by shaderc's DEPS file at that commit.  The S1 spike showed
# that these sources, built with the emscripten release below, reproduce the
# native SPIR-V and GLSL byte for byte on the whole 26.3 pipeline corpus.
#
# Read by port/scripts/build-wasm-shader-toolchain.sh (bash "source").
GAIUS_ST_EMSCRIPTEN_VERSION=6.0.10
GAIUS_ST_EMSCRIPTEN_COMMIT=d6c521a7f05449857c76bd99e396895583cf2083

GAIUS_ST_SHADERC_URL=https://github.com/google/shaderc.git
GAIUS_ST_SHADERC_COMMIT=2c8cae778eec0283b44acbe7ed1a386865d78799
GAIUS_ST_GLSLANG_URL=https://github.com/KhronosGroup/glslang.git
GAIUS_ST_GLSLANG_COMMIT=168d452a4f460d24b588fed08477a81c44ee27a1
GAIUS_ST_SPIRV_TOOLS_URL=https://github.com/KhronosGroup/SPIRV-Tools.git
GAIUS_ST_SPIRV_TOOLS_COMMIT=b707790a898e44038547df54580022fc1cf89c3d
GAIUS_ST_SPIRV_HEADERS_URL=https://github.com/KhronosGroup/SPIRV-Headers.git
GAIUS_ST_SPIRV_HEADERS_COMMIT=29981f65241605e08b0ede4cfeb999fe3b723c6a
GAIUS_ST_SPIRV_CROSS_URL=https://github.com/KhronosGroup/SPIRV-Cross.git
GAIUS_ST_SPIRV_CROSS_COMMIT=6c09849fe88c48eaed08413aa022aaa136a3a057
