      "dev.gaius.mc.seams.renderpearl1.RpEnumsTest",
      "dev.gaius.gpu.webgpu.CoreDowngradeTest",
      "dev.gaius.mc.seams.renderpearl1.RpDeviceFeaturesTest"
    ]
  },
  "entry": {
    "backend": "dev.gaius.mc.seams.renderpearl1.RpBackend",
