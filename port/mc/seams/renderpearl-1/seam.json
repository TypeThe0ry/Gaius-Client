{
  "generation": "renderpearl-1",
  "description": "WebGPU behind vanilla's renderpearl render SPI (GpuBackend -> FrontendGpuDevice -> GpuDeviceBackend), introduced with Minecraft 26.3. A delegating adapter onto port/gpu/webgpu-core.",
  "package": "dev.gaius.mc.seams.renderpearl1",
  "sources": "src/main/java",
  "tests": {
    "sources": "src/test/java",
