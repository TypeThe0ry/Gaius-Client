      "com/mojang/blaze3d/preprocessor/GlslPreprocessor",
      "com/mojang/blaze3d/systems/RenderPass",
      "com/mojang/blaze3d/vertex/VertexFormat",
      "com/mojang/blaze3d/vulkan/glsl/GlslCompiler"
    ]
  }
